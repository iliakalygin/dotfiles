{
    "layer": "bottom",
    "position": "bottom",
    "height": 28,

    "modules-left": ["custom/voidlogo", "custom/whitespace","sway/workspaces", "sway/mode"],
    "modules-center": [],
    "modules-right": ["tray", "custom/whitespace", "custom/separator", "pulseaudio", "custom/separator", "clock"],
    "sway/mode": {
        "format": " {}"
    },
    "custom/voidlogo": {
        "format":"  ",
        "tooltip": false
    },
    "sway/workspaces": {
        "format": "{name}",
        "disable-scroll": true
    },
    "sway/window": {
        "max-length": 80,
        "tooltip": false,
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 1
    },
    "pulseaudio": {
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "format": "{volume}%",
    },
    "tray": {
        "icon-size": 20
    },
    "cpu": {
        "format": "cpu {usage}%",
    },
   "memory": {
        "format": "{used:0.1f}G/{total:0.1f}G"
    },
    "custom/separator": {
        "exec": "echo \"::\"",
        "format": "{}"
    },
    "custom/whitespace": {
        "exec": "echo \" \"",
        "format": "{}"
    },
}
